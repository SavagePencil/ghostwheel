# Copy to .env and fill in your Neo4j instance details (.env is gitignored).
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# The working copy rounds author in. Leave unset for the engine-wide
# default ("scratch"); a knowledge base sharing its DBMS with others
# names its own here so working copies never collide.
# NEO4J_SCRATCH_DATABASE=

# Dependencies this knowledge base pins — one line per dependency, naming
# where that knowledge base's checkout lives on this machine (its
# committed backup is read there). Settings, never canon: the pin itself
# is a [Knowledge Base Dependency] entry authored in a gated round, at the dependency's
# edition. The name is the dependency's, in settings shape (upper case,
# runs of anything but letters and digits folded to one underscore).
# GHOSTWHEEL_DEPENDENCY_<NAME>=/path/to/that/knowledge-base

# A [Resolver]'s executable binding — how THIS machine opens a location
# kind a resolver declares (a project path, a command, credentials).
# Settings, never canon; the resolver row in canon names the scheme and
# the procedure, this line names what runs. (The verb that runs one
# awaits the first tool knowledge base.)
# GHOSTWHEEL_RESOLVER_<SCHEME>=<binding>

# Query-only reader credentials for the live canon connection. The engine's
# live database connection is physically read-only: canon changes flow only
# through the reviewed delta path (canonize --apply), never through an
# ad-hoc write. Point these at a Neo4j user granted read access and nothing
# more.
NEO4J_READER_USERNAME=canon_reader
NEO4J_READER_PASSWORD=changeme
